/*
  CSS 427 - RFID Parking Garage / MEGA 2560

  Minimum objectives:
  * Register RFID UID + driver/vehicle details in EDB on microSD.
  * Verify SD writes by reading back each new customer record.
  * Scan a registered tag to enter; allocate an available RAM spot.
  * Check out with E + a scan; release the RAM spot.
  * Show status on SSD1306 I2C OLED.
  * Send OPEN over HC-05 (Serial3) to an Uno gate controller;
    await ACK_OPEN and CLOSED messages.

  Demonstration stretch feature:
  * G + scan allows an unregistered guest; E + scan calculates a
    simulated fee using millis(). No physical payment or RTC.

  Hardware: Mega 2560, MFRC522, microSD SPI, SSD1306 128x64 I2C,
            HC-05 (pre-paired with slave on Uno hardware UART).

  Libraries: EDB 1.0.7 (legacy format), MFRC522 (Miguel Balboa),
             SD, SPI, Wire, Adafruit GFX, Adafruit SSD1306.

  Serial Monitor: 115200 baud, newline selected.
    R  - register NEXT scanned RFID tag
         then enter: First|Last|Car|LicensePlate
    E  - checkout NEXT scanned tag
    G  - guest entry NEXT scanned tag (stretch feature)
    S  - show spot occupancy
    C  - cancel the pending scan or registration
    H  - help
    (normal scan) - registered tenant entry

  NOTE: parking assignments are RAM-only; reset empties the garage.
  NOTE: PARKING.DB is EDB binary, NOT SQLite SQL.
  NOTE: EDB 1.0.7 callbacks return void; dbIoError tracks SD failures.
  NOTE: UID-only RFID is appropriate for demonstration, NOT secure access.
*/

#include <Arduino.h>
#include <SPI.h>
#include <SD.h>
#include <EDB.h>
#include <MFRC522.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <string.h>
#include <ctype.h>

// --- Pin configuration (Mega 2560) ---
const uint8_t PIN_SD_CS   = 4;
const uint8_t PIN_RFID_CS = 49;
const uint8_t PIN_RFID_RST = 5;
const uint8_t PIN_SPI_SS  = 53;  // Keep Mega hardware SS as OUTPUT.

const char DB_FILENAME[] = "PARKING.DB";
const unsigned long DB_CAPACITY_BYTES = 65536UL;
const uint8_t MAX_SPOTS = 8;
const unsigned long GATE_TIMEOUT_MS = 10000UL;
const unsigned long GUEST_HOURLY_RATE_DOLLARS = 5UL;

// --- Hardware and EDB storage ---
MFRC522 cardReader(PIN_RFID_CS, PIN_RFID_RST);
Adafruit_SSD1306 oled(128, 64, &Wire, -1);
bool oledReady = false;
File databaseFile;

// EDB 1.0.7 read/write callbacks return void.  EDB cannot see an SD
// seek/read/write failure itself, so record any such failure here.
bool dbIoError = false;

// Use random-access writes, not SD.open(..., FILE_WRITE): FILE_WRITE
// enables O_APPEND and breaks EDB's header/record seeking.
void edbWrite(unsigned long address, const byte *buffer, unsigned int length) {
  if (!databaseFile || !databaseFile.seek(address)) {
    dbIoError = true;
    return;
  }
  if (databaseFile.write(buffer, length) != length) {
    dbIoError = true;
  }
}

void edbRead(unsigned long address, byte *buffer, unsigned int length) {
  if (!databaseFile || !databaseFile.seek(address)) {
    dbIoError = true;
    memset(buffer, 0, length);
    return;
  }
  int received = databaseFile.read(buffer, length);
  if (received != (int)length) {
    dbIoError = true;
    if (received < 0) received = 0;
    memset(buffer + received, 0, length - (unsigned int)received);
  }
}
EDB registeredDB(&edbWrite, &edbRead);

// A class can be serialized by EDB because its only data members are
// fixed-size character arrays (no String, pointers, or virtual methods).
// This is the persistent customer record. Do not change field lengths
// after creating PARKING.DB without migrating the database.
class Customer {
public:
  char uid[21];         // up to 10 UID bytes, as 20 hexadecimal characters
  char firstName[51];   // 50 characters + null terminator
  char lastName[51];    // 50 characters + null terminator
  char car[51];         // 50 characters + null terminator
  char licensePlate[21];// 20 characters + null terminator

  bool set(const char *newUid, const char *first, const char *last,
           const char *carName, const char *plate) {
    memset(this, 0, sizeof(*this));
    if (!copyField(uid, sizeof(uid), newUid) ||
        !copyField(firstName, sizeof(firstName), first) ||
        !copyField(lastName, sizeof(lastName), last) ||
        !copyField(car, sizeof(car), carName) ||
        !copyField(licensePlate, sizeof(licensePlate), plate)) return false;
    for (uint8_t i = 0; licensePlate[i]; ++i) {
      licensePlate[i] = (char)toupper((unsigned char)licensePlate[i]);
    }
    return true;
  }

  bool matchesUid(const char *candidate) const {
    return strcmp(uid, candidate) == 0;
  }

private:
  static bool copyField(char *destination, size_t capacity,
                        const char *source) {
    if (source == NULL) return false;
    size_t n = strlen(source);
    if (n == 0 || n >= capacity) return false;
    memcpy(destination, source, n + 1);
    return true;
  }
};
static_assert(sizeof(Customer) == 195, "Customer storage layout changed");

// Persistent EDB operations are separate from transient parking management.
class CustomerDatabase {
public:
  CustomerDatabase() : ready(false) {}

  bool begin() {
    ready = false;
    if (!SD.begin(PIN_SD_CS)) {
      Serial.println(F("ERROR: SD card initialization failed."));
      return false;
    }

    // Only initialize a genuinely new database. Never erase customer data.
    bool newDatabase = !SD.exists(DB_FILENAME);
    databaseFile = SD.open(DB_FILENAME, O_READ | O_WRITE | O_CREAT);
    if (!databaseFile) {
      Serial.println(F("ERROR: Could not open PARKING.DB."));
      return false;
    }

    dbIoError = false;
    EDB_Status result = newDatabase
      ? registeredDB.create(0, DB_CAPACITY_BYTES, sizeof(Customer))
      : registeredDB.open(0);
    if (result != EDB_OK || dbIoError) {
      Serial.println(F("ERROR: EDB open/create or SD I/O failed."));
      Serial.println(F("Existing data has NOT been erased."));
      return false;
    }

    // EDB 1.0.7 has no public record-size getter. Check the on-disk
    // header before reading/writing Customer objects. This protects an
    // existing PARKING.DB created with another struct definition.
    EDB_Header onDisk = {};
    if (!databaseFile.seek(0) ||
        databaseFile.read((byte *)&onDisk, sizeof(onDisk)) !=
            (int)sizeof(onDisk) ||
        onDisk.rec_size != sizeof(Customer)) {
      Serial.println(F("ERROR: Existing EDB record layout is incompatible."));
      Serial.println(F("Back up PARKING.DB; do not overwrite it."));
      return false;
    }

    databaseFile.flush();
    ready = true;
    Serial.println(F("EDB customer database ready."));
    return true;
  }

  bool isReady() const { return ready; }
  unsigned long count() { return ready ? registeredDB.count() : 0; }

  // Returns: positive record number = found; 0 = absent; -1 = error.
  long findByUid(const char *uid, Customer &out) {
    if (!ready || uid == NULL || uid[0] == '\0') return -1;

    for (unsigned long number = 1; number <= registeredDB.count(); ++number) {
      if (!readCustomer(number, out)) return -1;
      if (out.matchesUid(uid)) return (long)number;
    }
    return 0;
  }

  // WRITE METHOD. RFID provides UID; serial form provides remaining fields.
  // Each field is stored separately in one fixed-size EDB customer record.
  bool writeUserToSD(const char *uid, const char *firstName,
                     const char *lastName, const char *car,
                     const char *licensePlate) {
    if (!ready) {
      Serial.println(F("Registration failed: database not ready."));
      return false;
    }

    // 1) Build a record, checking required values and field lengths.
    //    UID: 20 hex chars; names/car: 50 chars; license plate: 20.
    Customer incoming = {};
    if (!incoming.set(uid, firstName, lastName, car, licensePlate)) {
      Serial.println(F("Registration failed: empty or oversized field."));
      return false;
    }

    // 2) Reject duplicate RFID UID and plate. Scanned UIDs are uppercase
    //    hex strings; Customer::set() uppercases the new license plate.
    Customer existing = {};
    for (unsigned long number = 1; number <= registeredDB.count(); ++number) {
      if (!readCustomer(number, existing)) {
        Serial.println(F("Registration failed: database read error."));
        return false;
      }
      if (strcmp(existing.uid, incoming.uid) == 0) {
        Serial.println(F("Registration failed: RFID UID already registered."));
        return false;
      }
      if (strcmp(existing.licensePlate, incoming.licensePlate) == 0) {
        Serial.println(F("Registration failed: license plate already registered."));
        return false;
      }
    }

    // 3) Check capacity before appending (EDB handles this too).
    if (registeredDB.count() >= registeredDB.limit()) {
      Serial.println(F("Registration failed: EDB table is full."));
      return false;
    }

    // 4) Append the entire customer object as a 195-byte EDB record.
    //    EDB's void callbacks do not report SD failures; dbIoError does.
    unsigned long newRecordNumber = registeredDB.count() + 1UL;
    dbIoError = false;
    EDB_Status result = registeredDB.appendRec(EDB_REC incoming);
    if (result != EDB_OK || dbIoError) {
      Serial.println(F("Registration failed: EDB or underlying SD write error."));
      if (dbIoError) ready = false;  // Stop on possible partial DB write.
      return false;
    }

    // 5) Flush and read back the new record to check stored contents.
    databaseFile.flush();
    Customer verified = {};
    if (!readCustomer(newRecordNumber, verified) ||
        memcmp(&verified, &incoming, sizeof(Customer)) != 0) {
      Serial.println(F("Registration failed: SD read-back verification failed."));
      ready = false;  // Investigate the SD card before further writes.
      return false;
    }

    Serial.print(F("REGISTERED: "));
    Serial.print(incoming.firstName);
    Serial.print(' ');
    Serial.print(incoming.lastName);
    Serial.print(F("; UID="));
    Serial.println(incoming.uid);
    Serial.print(F("EDB record number: "));
    Serial.println(newRecordNumber);
    return true;
  }

private:
  bool ready;

  // Guard against corrupted/mismatched records before using strcmp().
  static bool isValidCustomer(const Customer &customer) {
    return customer.uid[0] != '\0' &&
           customer.firstName[0] != '\0' &&
           customer.lastName[0] != '\0' &&
           customer.car[0] != '\0' &&
           customer.licensePlate[0] != '\0' &&
           memchr(customer.uid, '\0', sizeof(customer.uid)) != NULL &&
           memchr(customer.firstName, '\0', sizeof(customer.firstName)) != NULL &&
           memchr(customer.lastName, '\0', sizeof(customer.lastName)) != NULL &&
           memchr(customer.car, '\0', sizeof(customer.car)) != NULL &&
           memchr(customer.licensePlate, '\0', sizeof(customer.licensePlate)) != NULL;
  }

  bool readCustomer(unsigned long recordNumber, Customer &out) {
    dbIoError = false;
    EDB_Status result = registeredDB.readRec(recordNumber, EDB_REC out);
    if (result != EDB_OK || dbIoError || !isValidCustomer(out)) {
      // Avoid further transactions if the file has a bad layout or SD I/O.
      ready = false;
      return false;
    }
    return true;
  }
};

CustomerDatabase customers;

// A slot is transient RAM state, not part of the persistent EDB record.
struct ParkingSpot {
  char uid[21];
  bool guest;
  unsigned long entryMillis;
};

enum GarageState {
  STATE_IDLE,
  STATE_REGISTER_SCAN,
  STATE_REGISTER_DETAILS,
  STATE_EXIT_SCAN,
  STATE_GUEST_SCAN,
  STATE_WAIT_GATE_ACK,
  STATE_WAIT_GATE_CLOSED
};

enum GateAction { GATE_NONE, GATE_ENTRY, GATE_EXIT };

class Garage {
public:
  Garage() : state(STATE_IDLE), action(GATE_NONE), pendingSpot(-1),
             commandLength(0), btLength(0), lineOverflow(false),
             gateStartedAt(0) {
    memset(spots, 0, sizeof(spots));
    memset(registrationUid, 0, sizeof(registrationUid));
    memset(commandBuffer, 0, sizeof(commandBuffer));
    memset(btBuffer, 0, sizeof(btBuffer));
    memset(checkoutFeeText, 0, sizeof(checkoutFeeText));
  }

  void begin() {
    Serial3.begin(9600); // Mega HC-05 serial: TX3 = D14, RX3 = D15
    show("Parking garage", "Scan RFID card", "R/E/G/S/H commands");
    Serial.println(F("--- CSS 427 Parking Garage ---"));
    Serial.print(F("Registered customers: "));
    Serial.println(customers.count());
    help();
  }

  void tick() {
    readConsole();
    readBluetooth();

    if (state == STATE_WAIT_GATE_ACK || state == STATE_WAIT_GATE_CLOSED) {
      if ((unsigned long)(millis() - gateStartedAt) > GATE_TIMEOUT_MS) {
        Serial.println(F("ERROR: Gate reply timeout. Parking assignment preserved."));
        show("Gate status unknown", "Check Uno / HC-05", "See Serial Monitor");
        // Conservatively preserve the spot after an uncertain gate action.
        state = STATE_IDLE;
        action = GATE_NONE;
        pendingSpot = -1;
      }
      return;
    }

    if (state == STATE_REGISTER_DETAILS) return; // waiting for Serial line
    scanRfid();
  }

private:
  ParkingSpot spots[MAX_SPOTS];
  GarageState state;
  GateAction action;
  int pendingSpot;
  char registrationUid[21];
  char commandBuffer[190];
  char btBuffer[24];
  char checkoutFeeText[22]; // Guest fee persists on OLED through checkout.
  uint8_t commandLength;
  uint8_t btLength;
  bool lineOverflow;
  unsigned long gateStartedAt;

  void show(const char *line1, const char *line2, const char *line3) {
    Serial.print(F("DISPLAY: "));
    Serial.print(line1);
    Serial.print(F(" / "));
    Serial.print(line2);
    Serial.print(F(" / "));
    Serial.println(line3);
    if (!oledReady) return;
    oled.clearDisplay();
    oled.setTextSize(1);
    oled.setTextColor(SSD1306_WHITE);
    oled.setCursor(0, 0);
    oled.println(line1);
    oled.setCursor(0, 21);
    oled.println(line2);
    oled.setCursor(0, 42);
    oled.println(line3);
    oled.display();
  }

  void help() {
    Serial.println(F("NORMAL SCAN = registered tenant entry"));
    Serial.println(F("R + Enter = register next RFID; then First|Last|Car|Plate"));
    Serial.println(F("E + Enter = exit/checkout next RFID"));
    Serial.println(F("G + Enter = guest entry next RFID (stretch)"));
    Serial.println(F("S + Enter = print current spots; C = cancel; H = help"));
    Serial.println(F("Important: REMOVE card between scans."));
  }

  int occupiedSpot(const char *uid) const {
    for (uint8_t i = 0; i < MAX_SPOTS; ++i) {
      if (strcmp(spots[i].uid, uid) == 0) return i;
    }
    return -1;
  }

  int firstFreeSpot() const {
    for (uint8_t i = 0; i < MAX_SPOTS; ++i) {
      if (spots[i].uid[0] == '\0') return i;
    }
    return -1;
  }

  void printSpots() {
    Serial.println(F("--- Parking spots (RAM) ---"));
    for (uint8_t i = 0; i < MAX_SPOTS; ++i) {
      Serial.print(F("Spot "));
      Serial.print(i + 1);
      Serial.print(F(": "));
      if (spots[i].uid[0] == '\0') Serial.println(F("FREE"));
      else {
        Serial.print(spots[i].guest ? F("GUEST ") : F("REGISTERED "));
        Serial.println(spots[i].uid);
      }
    }
  }

  void readConsole() {
    while (Serial.available()) {
      char ch = (char)Serial.read();
      if (ch == '\r') continue;
      if (ch == '\n') {
        if (lineOverflow) {
          Serial.println(F("Input exceeded 189 characters; ignored."));
        } else if (commandLength > 0) {
          commandBuffer[commandLength] = '\0';
          handleConsoleLine(commandBuffer);
        }
        commandLength = 0;
        lineOverflow = false;
      } else if (!lineOverflow) {
        if ((size_t)commandLength + 1 < sizeof(commandBuffer)) {
          commandBuffer[commandLength++] = ch;
        } else {
          lineOverflow = true;
        }
      }
    }
  }

  void handleConsoleLine(char *line) {
    if (strcmp(line, "H") == 0 || strcmp(line, "h") == 0) {
      help();
      return;
    }
    if (strcmp(line, "S") == 0 || strcmp(line, "s") == 0) {
      printSpots();
      return;
    }
    if (state == STATE_WAIT_GATE_ACK || state == STATE_WAIT_GATE_CLOSED) {
      Serial.println(F("Gate is moving; cannot change mode."));
      return;
    }
    if (strcmp(line, "C") == 0 || strcmp(line, "c") == 0) {
      state = STATE_IDLE;
      registrationUid[0] = '\0';
      show("Cancelled", "Scan for entry", "");
      return;
    }
    if (state == STATE_REGISTER_DETAILS) {
      saveRegistrationLine(line);
      return;
    }
    if (strcmp(line, "R") == 0 || strcmp(line, "r") == 0) {
      state = STATE_REGISTER_SCAN;
      show("Registration mode", "Scan new card", "");
    } else if (strcmp(line, "E") == 0 || strcmp(line, "e") == 0) {
      state = STATE_EXIT_SCAN;
      show("Checkout mode", "Scan parked card", "");
    } else if (strcmp(line, "G") == 0 || strcmp(line, "g") == 0) {
      state = STATE_GUEST_SCAN;
      show("Guest mode", "Scan guest card", "");
    } else {
      Serial.println(F("Unknown command. Type H for help."));
    }
  }

  void saveRegistrationLine(char *line) {
    char *field[4];
    field[0] = line;
    for (uint8_t i = 1; i < 4; ++i) {
      char *delimiter = strchr(field[i - 1], '|');
      if (delimiter == NULL) {
        Serial.println(F("Invalid form; use First|Last|Car|Plate"));
        state = STATE_IDLE;
        return;
      }
      *delimiter = '\0';
      field[i] = delimiter + 1;
    }
    if (strchr(field[3], '|') != NULL) {
      Serial.println(F("Registration error: too many fields."));
      state = STATE_IDLE;
      return;
    }
    bool saved = customers.writeUserToSD(registrationUid, field[0],
                                          field[1], field[2], field[3]);
    state = STATE_IDLE;
    registrationUid[0] = '\0';
    if (saved) show("Registration saved", "Card is ready", "Scan to enter");
    else show("Registration failed", "See Serial Monitor", "");
  }

  void scanRfid() {
    if (!cardReader.PICC_IsNewCardPresent()) return;
    if (!cardReader.PICC_ReadCardSerial()) return;

    char uid[21] = {};
    uint8_t count = cardReader.uid.size;
    if (count > 10) {
      show("RFID unsupported", "UID too long", "");
    } else {
      const char hexDigits[] = "0123456789ABCDEF";
      for (uint8_t i = 0; i < count; ++i) {
        byte b = cardReader.uid.uidByte[i];
        uid[2 * i] = hexDigits[(b >> 4) & 15];
        uid[2 * i + 1] = hexDigits[b & 15];
      }
      uid[2 * count] = '\0';
      Serial.print(F("RFID scanned: "));
      Serial.println(uid);
      GarageState request = state;
      state = STATE_IDLE;  // One-shot request: next scan defaults to entry.
      switch (request) {
        case STATE_REGISTER_SCAN:
          strncpy(registrationUid, uid, sizeof(registrationUid) - 1);
          registrationUid[sizeof(registrationUid) - 1] = '\0';
          state = STATE_REGISTER_DETAILS;
          Serial.println(F("Enter: First|Last|Car|Plate"));
          Serial.println(F("Example: Jane|Doe|Toyota Camry|ABC1234"));
          show("Card accepted", "Enter details on", "Serial Monitor");
          break;
        case STATE_EXIT_SCAN: exitGarage(uid); break;
        case STATE_GUEST_SCAN: guestEnter(uid); break;
        default: enterGarage(uid); break;
      }
    }

    cardReader.PICC_HaltA();
    cardReader.PCD_StopCrypto1();
  }

  void enterGarage(const char *uid) {
    Customer customer = {};
    long found = customers.findByUid(uid, customer);
    if (found < 0) {
      show("DATABASE ERROR", "Entry denied", "");
      return;
    }
    if (found == 0) {
      show("Unregistered card", "Entry denied", "Use G for guest");
      return;
    }
    if (occupiedSpot(uid) >= 0) {
      show("Already inside", "Checkout with E", "");
      return;
    }
    int spot = firstFreeSpot();
    if (spot < 0) {
      show("Garage is FULL", "Entry denied", "");
      return;
    }
    checkoutFeeText[0] = '\0';
    reserveSpot(spot, uid, false);
    char label[22];
    snprintf(label, sizeof(label), "Assigned spot: %d", spot + 1);
    Serial.print(F("WELCOME: "));
    Serial.print(customer.firstName);
    Serial.print(' ');
    Serial.println(customer.lastName);
    show("Welcome!", label, "Opening gate...");
    sendGateOpen(GATE_ENTRY, spot);
  }

  // Stretch objective: temporary guest card; not inserted into EDB.
  void guestEnter(const char *uid) {
    Customer result = {};
    long found = customers.findByUid(uid, result);
    if (found < 0) {
      show("DATABASE ERROR", "Guest denied", "");
      return;
    }
    if (found > 0) {
      show("Registered tenant", "Scan normally", "for entry");
      return;
    }
    if (occupiedSpot(uid) >= 0) {
      show("Already inside", "Checkout with E", "");
      return;
    }
    int spot = firstFreeSpot();
    if (spot < 0) {
      show("Garage is FULL", "Guest denied", "");
      return;
    }
    checkoutFeeText[0] = '\0';
    reserveSpot(spot, uid, true);
    char label[22];
    snprintf(label, sizeof(label), "Guest spot: %d", spot + 1);
    show("Guest accepted", label, "Opening gate...");
    sendGateOpen(GATE_ENTRY, spot);
  }

  void exitGarage(const char *uid) {
    checkoutFeeText[0] = '\0';
    int spot = occupiedSpot(uid);
    if (spot < 0) {
      show("Checkout denied", "Card not parked", "");
      return;
    }
    if (spots[spot].guest) {
      // Billing is demonstration-only. millis() resets on power loss.
      unsigned long elapsed = millis() - spots[spot].entryMillis;
      unsigned long chargedHours = elapsed / 3600000UL;
      if ((elapsed % 3600000UL) != 0 || chargedHours == 0) ++chargedHours;
      unsigned long fee = chargedHours * GUEST_HOURLY_RATE_DOLLARS;
      char feeText[22];
      snprintf(feeText, sizeof(feeText), "Fee: $%lu (%luh)", fee, chargedHours);
      strncpy(checkoutFeeText, feeText, sizeof(checkoutFeeText) - 1);
      checkoutFeeText[sizeof(checkoutFeeText) - 1] = '\0';
      show("Guest checkout", checkoutFeeText, "No payment taken");
      Serial.print(F("GUEST CHECKOUT: simulated fee $"));
      Serial.println(fee);
    } else {
      show("Tenant checkout", "Opening exit gate", "");
    }
    sendGateOpen(GATE_EXIT, spot);
  }

  void reserveSpot(int spot, const char *uid, bool guest) {
    strncpy(spots[spot].uid, uid, sizeof(spots[spot].uid) - 1);
    spots[spot].uid[sizeof(spots[spot].uid) - 1] = '\0';
    spots[spot].guest = guest;
    spots[spot].entryMillis = millis();
  }

  void sendGateOpen(GateAction requestedAction, int spot) {
    action = requestedAction;
    pendingSpot = spot;
    gateStartedAt = millis();
    state = STATE_WAIT_GATE_ACK;
    Serial3.println(F("OPEN"));
    Serial.println(F("BLUETOOTH -> OPEN"));
  }

  void readBluetooth() {
    while (Serial3.available()) {
      char ch = (char)Serial3.read();
      if (ch == '\r') continue;
      if (ch == '\n') {
        btBuffer[btLength] = '\0';
        handleGateMessage(btBuffer);
        btLength = 0;
      } else if ((size_t)btLength + 1 < sizeof(btBuffer)) {
        btBuffer[btLength++] = ch;
      } else {
        btLength = 0; // discard malformed/oversized line
      }
    }
  }

  void handleGateMessage(const char *message) {
    Serial.print(F("BLUETOOTH <- "));
    Serial.println(message);
    if (strcmp(message, "ACK_OPEN") == 0 && state == STATE_WAIT_GATE_ACK) {
      state = STATE_WAIT_GATE_CLOSED;
      if (action == GATE_ENTRY) {
        char label[22];
        snprintf(label, sizeof(label), "Go to spot: %d", pendingSpot + 1);
        show("Gate is OPEN", label, "");
      } else {
        show("Gate is OPEN", "Proceed to exit", checkoutFeeText);
      }
    } else if (strcmp(message, "CLOSED") == 0 &&
               (state == STATE_WAIT_GATE_ACK || state == STATE_WAIT_GATE_CLOSED)) {
      // Free the space only after the Uno confirms gate-close command.
      if (action == GATE_EXIT && pendingSpot >= 0) {
        spots[pendingSpot].uid[0] = '\0';
        spots[pendingSpot].guest = false;
        spots[pendingSpot].entryMillis = 0;
        if (checkoutFeeText[0]) {
          show("Checkout complete", checkoutFeeText, "No payment taken");
        } else {
          show("Checkout complete", "Space is available", "");
        }
      } else if (action == GATE_ENTRY) {
        char label[22];
        snprintf(label, sizeof(label), "Park in spot: %d", pendingSpot + 1);
        show("Entry complete", label, "");
      }
      state = STATE_IDLE;
      action = GATE_NONE;
      pendingSpot = -1;
    } else if (strcmp(message, "BUSY") == 0 && state == STATE_WAIT_GATE_ACK) {
      Serial.println(F("Gate busy; slot retained for safety."));
      show("Gate is busy", "Check gate state", "");
      state = STATE_IDLE;
      action = GATE_NONE;
      pendingSpot = -1;
    }
  }
};

Garage garage;

void setup() {
  Serial.begin(115200);
  pinMode(PIN_SPI_SS, OUTPUT);
  pinMode(PIN_SD_CS, OUTPUT);
  pinMode(PIN_RFID_CS, OUTPUT);
  digitalWrite(PIN_SPI_SS, HIGH);
  digitalWrite(PIN_SD_CS, HIGH);
  digitalWrite(PIN_RFID_CS, HIGH);

  Wire.begin();
  oledReady = oled.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  if (!oledReady) Serial.println(F("OLED not detected; Serial Monitor still works."));

  SPI.begin();
  // Do not proceed with scans/commands if the permanent database fails.
  if (!customers.begin()) {
    Serial.println(F("FATAL: Garage disabled until SD/EDB is fixed."));
    return;
  }
  cardReader.PCD_Init();
  garage.begin();
}

void loop() {
  if (customers.isReady()) garage.tick();
}

